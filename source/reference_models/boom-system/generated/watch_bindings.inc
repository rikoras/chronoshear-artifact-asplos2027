void install_watch_dispatch(ModelBindings& b) {
  b.set_dispatch(SamplePlacement::PreStep, &dispatch_PreStep);
  b.set_dispatch(SamplePlacement::Core, &dispatch_Core);
  b.set_dispatch(SamplePlacement::Frontend, &dispatch_Frontend);
  b.set_dispatch(SamplePlacement::Memory, &dispatch_Memory);
  b.set_dispatch(SamplePlacement::End, &dispatch_End);
  b.set_exact_dispatch(&dispatch_exact);
}
