static void rest(const SystemGuider& m, BatchSlots slots) {
  (void)m; (void)slots;
  [[maybe_unused]] const auto& coherent = m.fabric().coherent_memory_oracles();
  [[maybe_unused]] const auto& mem = m.fabric().mbus_memory_oracles();
  [[maybe_unused]] const auto& mmio = m.fabric().mmio_memory_oracles();
    const auto& c_queue =
        m.memory().fabric_for_diagnostic().c_queue_for_diagnostic();
  batch_store(slots, 0, m.fabric().coherent_memory_oracles().tl2axi4_arw_bank);
  batch_store(slots, 1, m.fabric().mbus_memory_oracles().frag_busy);
  batch_store(slots, 2, m.fabric().mbus_memory_oracles().frag_busy_1);
  batch_store(slots, 3, m.fabric().mbus_memory_oracles().frag_deq_bank);
  batch_store(slots, 4, m.fabric().mbus_memory_oracles().frag_deq_1_bank);
  batch_store(slots, 5, m.fabric().mmio_memory_oracles().buf_w_deq_ptr);
  batch_store(slots, 6, m.fabric().mmio_memory_oracles().frag_busy);
  batch_store(slots, 7, m.fabric().mmio_memory_oracles().frag_busy_1);
  batch_store(slots, 8, m.fabric().mmio_memory_oracles().frag_deq_bank);
  batch_store(slots, 9, m.fabric().mmio_memory_oracles().frag_deq_1_bank);
  batch_store(slots, 10, c_queue.enq_ptr());
  if (slots.gather_index[11] < 0) batch_store(slots, 11, m.fabric().plic_out_back_bank_0());
  if (slots.gather_index[12] < 0) batch_store(slots, 12, m.fabric().plic_out_back_bank_1());
  if (slots.gather_index[13] < 0) batch_store(slots, 13, m.fabric().plic_out_back_data());
}
