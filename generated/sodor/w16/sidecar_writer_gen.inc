      if (position == 0) {
        block_cache_->tohost_sig0 = sw_tohost_sig0;
        block_cache_->tohost_valid = true;
        block_cache_->tohost_uniform = true;
      } else if (sw_tohost_changed) {
        block_cache_->tohost_sig0 = sw_tohost_sig0;
        block_cache_->tohost_valid = true;
        block_cache_->tohost_uniform = false;
      }
    }
    const bool sw_constant_cache_match = block_cache_ && block_cache_->constant_valid && block_cache_->constant_uniform;
    if (position == 0 && !sw_constant_cache_match) {
      sw_fill_tail<uint32_t>(block, 4224u, position, static_cast<uint64_t>(env.raw_reg(0)));  // cold: regfile.regfile.io_dm_rdata_MPORT
    }
    if (block_cache_) {
      if (position == 0) {
        block_cache_->constant_valid = true;
        block_cache_->constant_uniform = true;
      }
    }
  }

 private:
  uint64_t csr_sig0_ = 0;
  bool csr_valid_ = false;
  uint64_t host_sig0_ = 0;
  uint64_t host_sig1_ = 0;
  bool host_valid_ = false;
  uint64_t tohost_sig0_ = 0;
  bool tohost_valid_ = false;
  SodorDenseOracleBlockCache* block_cache_ = nullptr;
};

// BOOM-style change transport.  The producer records only streams that
// move.  Kept as --producer=sparse for experiments on this small ABI;
// the consumer expands changes before evaluating a window.
struct SodorOracleDelta {
  std::array<uint8_t, SW_NUM_STREAMS> count{};
  std::array<std::array<uint8_t, SW_CPW>, SW_NUM_STREAMS> position{};
  std::array<std::array<uint64_t, SW_CPW>, SW_NUM_STREAMS> value{};
};

